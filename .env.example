# LYnto Worker secrets — copy to .secrets/production.env (or .dev.vars for local) and fill in.
# Never commit real values. Uploaded with: wrangler deploy --secrets-file .secrets/production.env

# 32 random bytes, base64. Encrypts delivery details + integration credentials. BACK IT UP — losing it loses that data.
DATA_KEY=
# Long random string. HMAC key for customer order tokens, idempotency and IP hashing.
TOKEN_SECRET=
# Long random string (>= 32 chars). One-time owner bootstrap: /admin/setup-account#token=...
SETUP_TOKEN=
# Optional: Gemini API key (free tier). Can also be set in Admin → Setup → Gemini.
GEMINI_API_KEY=

# Optional hardening: Cloudflare Access in front of /admin (both required to enforce)
# ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# ACCESS_AUD=

# Local/staging only (ignored when APP_ENV=production)
# APP_ENV=staging
# PUBLIC_BASE_URL=http://localhost:4173
# TEST_PROVIDER_BASE=http://127.0.0.1:9799
# RATE_LIMIT_MULTIPLIER=20

# Integration credentials (Resend, WhatsApp, Meta CAPI) are NOT env vars:
# enter them in Admin → Setup; they are stored AES-GCM encrypted in D1.
