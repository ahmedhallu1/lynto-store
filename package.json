{
  "name": "lynto-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LYnto digital store \u2014 React + Vite on Cloudflare Workers, D1 and R2.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "node tests/e2e/run.mjs",
    "brand": "node scripts/brand-assets.mjs",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply lynto-db --local",
    "db:migrate:staging": "wrangler d1 migrations apply lynto-db-staging --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply lynto-db --remote",
    "deploy:staging": "npm run build:staging && wrangler deploy --config dist/lynto/wrangler.json --secrets-file .secrets/staging.env",
    "deploy:prod": "npm run build && wrangler deploy --config dist/lynto/wrangler.json --secrets-file .secrets/production.env",
    "prebuild": "node scripts/product-cards.mjs --catalog-json brand-source/catalog-additions.json --missing-only && node scripts/seo-assets.mjs",
    "prebuild:staging": "node scripts/product-cards.mjs --catalog-json brand-source/catalog-additions.json --missing-only && node scripts/seo-assets.mjs",
    "test:seo": "node tests/e2e/seo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "miniflare": "5.20261006.1-alpha",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
